# compose.full.yaml 이 읽는다. 실제 값을 담은 .env 는 커밋하지 않는다.
#
# prod 프로파일은 이 값들에 기본값을 두지 않는다. 하나라도 비면 기동이 실패한다.
# 개발용 기본값으로 조용히 뜨면 운영 인스턴스가 엉뚱한 곳에 붙고도 health 는 UP 을 보고한다.

POSTGRES_DB=stay
POSTGRES_USER=stay
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://postgres:5432/stay
DB_USERNAME=stay
DB_PASSWORD=change-me

SUPPLIER_BASE_URL=http://mock-supplier:9090
SUPPLIER_API_KEY=change-me

CATALOG_SYNC_INTERVAL=1h
